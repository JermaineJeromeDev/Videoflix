# --- Django Core Settings ---
SECRET_KEY="your_secret_key_here"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5500,https://videoflix-frontend-five.vercel.app

# --- Database (Supabase PostgreSQL) ---
# Ersetzt DB_NAME, DB_HOST, DB_USER etc.
DATABASE_URL="postgres://postgres:[password]@[project-id].supabase.co:5432/postgres"

# --- Storage (Supabase S3 Videos) ---
USE_S3=True
AWS_ACCESS_KEY_ID="your_supabase_access_key"
AWS_SECRET_ACCESS_KEY="your_supabase_secret_key"
AWS_STORAGE_BUCKET_NAME="your_bucket_name"
AWS_S3_ENDPOINT_URL="https://[project-id].supabase.co/storage/v1/s3"

# --- Cache & Queues (Upstash Serverless Redis) ---
# Ersetzt REDIS_HOST, REDIS_PORT, REDIS_DB etc.
REDIS_URL="redis://default:[password]@[endpoint].upstash.io:6379/0"

# --- Email (SMTP) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_user_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=default_from_email
EMAIL_LOGO_URL=https://i.postimg.cc/gj1d03gG/Logo.png
